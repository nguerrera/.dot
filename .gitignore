# ignore emacs backup/auto-save/lock files
*~
*#
.#*

# ignore Mac .DS_Store
.DS_Store

# ignore byte-compiled elisp
*.elc

# ignore byte-compiled python
__pycache__/

# ignore all the transient stuff in .emacs.d/
.emacs.d/*
!.emacs.d/init.el
!.emacs.d/custom.el
!.emacs.d/early-init.el
!.emacs.d/.mc-lists.el
!.emacs.d/lisp/
!.emacs.d/themes/

# ignore all the transient stuff in .claude.user/, which is deployed as the
# home directory's ~/.claude and fills with credentials, transcripts, uploads
# and pasted images. tools/check enforces this list rather than trusting it.
.claude.user/*
!.claude.user/CLAUDE.md
!.claude.user/settings.json
!.claude.user/hooks/
!.claude.user/skills/

