#!/usr/bin/env python3
"""Send a Wake-on-LAN magic packet to a host on the local network.

Usage: wake <hostname|ip>

The name is resolved to an address, the address to a MAC through the
kernel's neighbor (ARP) table, and the MAC is saved under
$XDG_CACHE_HOME/wake so the host can be woken after the table forgets
it.

Nothing here has to be installed. What the standard library does not
answer for itself comes from what ships with the OS: the neighbor table
from /proc/net/arp on Linux, arp(8) on macOS and GetIpNetTable on
Windows, and the interface and its broadcast address from getifaddrs(3)
on Linux and macOS and GetIpAddrTable on Windows. The three system
calls among those go through ctypes. The interface is the one the
kernel would send to the host from, and the packet goes out on a plain
UDP socket.
"""

import ctypes
import ctypes.util
import ipaddress
import os
import re
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path

# The discard port, which is where a magic packet is conventionally
# addressed: a wakeable card matches the payload below the UDP layer, so
# no port has to be listening, and a datagram sent only to be sent has
# nowhere better to go either.
DISCARD_PORT = 9

IFF_BROADCAST = 0x2

# Where a packet goes when the interface names no broadcast address of
# its own. It reaches the local segment and no further.
LIMITED_BROADCAST = "255.255.255.255"

# How long to let the kernel finish resolving an address that answers.
RESOLVE_TIMEOUT = 1.0

# The length MIB_IPNETROW reserves for a hardware address, of which an
# Ethernet MAC fills six.
MAXLEN_PHYSADDR = 8

# What an iphlpapi table call answers a buffer smaller than the table
# with, having written the size it wants back through the same argument.
ERROR_INSUFFICIENT_BUFFER = 122

# What GetIpNetTable returns where the neighbor table is empty.
ERROR_NO_DATA = 232

# How many times to ask iphlpapi for a table: the call that reports the
# size, the call that reads it, and one more for a table that grew in
# between.
TABLE_ATTEMPTS = 3

# MIB_IPNETROW's type for an entry whose request has not come back.
IPNET_TYPE_INVALID = 2

MAC_TEXT = re.compile(r"^[0-9a-fA-F]{1,2}(?:[:-][0-9a-fA-F]{1,2}){5}$")


class Ifaddrs(ctypes.Structure):
    pass


Ifaddrs._fields_ = [
    ("ifa_next", ctypes.POINTER(Ifaddrs)),
    ("ifa_name", ctypes.c_char_p),
    ("ifa_flags", ctypes.c_uint),
    ("ifa_addr", ctypes.c_void_p),
    ("ifa_netmask", ctypes.c_void_p),
    ("ifa_broadaddr", ctypes.c_void_p),
    ("ifa_data", ctypes.c_void_p),
]


class MibIpAddrRow(ctypes.Structure):
    """A row of GetIpAddrTable: one IPv4 address on one interface."""

    _fields_ = [
        ("address", ctypes.c_uint32),
        ("index", ctypes.c_uint32),
        ("netmask", ctypes.c_uint32),
        # Documented as the interface's broadcast address and in
        # practice 1, which stands for the host bits being ones rather
        # than naming the address they make. The address is computed
        # from the network instead.
        ("broadcast", ctypes.c_uint32),
        ("reassembly_size", ctypes.c_uint32),
        ("unused", ctypes.c_uint16),
        ("type", ctypes.c_uint16),
    ]


class MibIpNetRow(ctypes.Structure):
    """A row of GetIpNetTable: one neighbor, on one interface."""

    _fields_ = [
        ("index", ctypes.c_uint32),
        ("physical_length", ctypes.c_uint32),
        ("physical", ctypes.c_ubyte * MAXLEN_PHYSADDR),
        ("address", ctypes.c_uint32),
        ("type", ctypes.c_uint32),
    ]


def fail(message):
    raise SystemExit(f"wake: {message}")


def sockaddr_ipv4(pointer):
    """The dotted quad in a sockaddr, or None where it holds none.

    BSD keeps a length in the first byte and stores a sockaddr no longer
    than it has to be, so a netmask can stop partway through its address
    bytes; the bytes past the length are zero.
    """
    if not pointer:
        return None
    header = ctypes.string_at(pointer, 2)
    if sys.platform == "darwin":
        length, family = header[0], header[1]
    else:
        length, family = 8, struct.unpack("=H", header)[0]
    if family != socket.AF_INET or length <= 4:
        return None
    octets = ctypes.string_at(pointer, min(length, 8))[4:]
    return socket.inet_ntoa(octets.ljust(4, b"\0"))


def broadcast_interfaces_unix():
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    libc.getifaddrs.argtypes = [ctypes.POINTER(ctypes.POINTER(Ifaddrs))]
    libc.getifaddrs.restype = ctypes.c_int
    libc.freeifaddrs.argtypes = [ctypes.POINTER(Ifaddrs)]

    head = ctypes.POINTER(Ifaddrs)()
    if libc.getifaddrs(ctypes.byref(head)) != 0:
        code = ctypes.get_errno()
        fail(f"cannot list interfaces: {os.strerror(code)}")
    try:
        found = []
        entry = head
        while entry:
            item = entry.contents
            entry = item.ifa_next
            if not item.ifa_flags & IFF_BROADCAST:
                continue
            address = sockaddr_ipv4(item.ifa_addr)
            netmask = sockaddr_ipv4(item.ifa_netmask)
            broadcast = sockaddr_ipv4(item.ifa_broadaddr)
            if not (address and netmask):
                continue
            if broadcast in (None, "0.0.0.0"):
                broadcast = LIMITED_BROADCAST
            network = ipaddress.IPv4Interface(f"{address}/{netmask}").network
            found.append(
                (item.ifa_name.decode(), address, network, broadcast)
            )
        return found
    finally:
        libc.freeifaddrs(head)


def dotted_quad(value):
    """The dotted quad in a word iphlpapi returns an address in.

    The word holds the four bytes in network order, which packing it in
    the machine's order lays back out as they arrived.
    """
    return socket.inet_ntoa(struct.pack("=I", value))


def iphlpapi_table(name, row_type):
    """The rows of an iphlpapi table, into a buffer sized by asking.

    Each of these tables arrives as a count and then its fixed-size
    rows, in a buffer the caller supplies. A call handed one too small
    reports the size it wants through the same argument, which is what
    the first call is for.
    """
    function = getattr(ctypes.WinDLL("iphlpapi"), name)
    size = ctypes.c_uint32(0)
    for _ in range(TABLE_ATTEMPTS):
        # The first call is handed nothing to fill, since the size a
        # buffer would have to be is what it is being asked for.
        buffer = None
        if size.value:
            buffer = ctypes.create_string_buffer(size.value)
        code = function(buffer, ctypes.byref(size), False)
        if code == ERROR_NO_DATA:
            return []
        if code == 0:
            count = ctypes.c_uint32.from_buffer(buffer).value
            return list((row_type * count).from_buffer(buffer, 4))
        if code != ERROR_INSUFFICIENT_BUFFER:
            fail(f"cannot read {name}: {ctypes.FormatError(code)}")
    fail(f"cannot read {name}: it grew past every buffer sized for it")


def broadcast_interfaces_windows():
    found = []
    for row in iphlpapi_table("GetIpAddrTable", MibIpAddrRow):
        address = dotted_quad(row.address)
        # A loopback address is the one thing here with no segment to
        # broadcast on, and a netmask of zero names no network at all.
        if not row.netmask or ipaddress.IPv4Address(address).is_loopback:
            continue
        network = ipaddress.IPv4Interface(
            f"{address}/{dotted_quad(row.netmask)}"
        ).network
        found.append((
            socket.if_indextoname(row.index),
            address,
            network,
            str(network.broadcast_address),
        ))
    return found


def broadcast_interfaces():
    """Each broadcasting IPv4 interface: name, address, network, broadcast."""
    if sys.platform == "win32":
        return broadcast_interfaces_windows()
    return broadcast_interfaces_unix()


def normalize_mac(text):
    """A MAC in canonical form, or None where the text is not one.

    macOS prints an octet below 0x10 as a single digit, so the parts are
    padded rather than matched at a fixed width.
    """
    if not text or not MAC_TEXT.match(text):
        return None
    mac = ":".join(f"{int(part, 16):02x}" for part in re.split("[:-]", text))
    # An address of all zeroes is how a table spells an entry it never
    # resolved.
    return None if mac == "00:00:00:00:00:00" else mac


def neighbor_mac_linux(ip, device):
    # Columns: address, HW type, flags, HW address, mask, device.
    try:
        table = Path("/proc/net/arp").read_text()
    except OSError as error:
        fail(f"cannot read /proc/net/arp: {error.strerror}")
    for line in table.splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 6 and fields[0] == ip and fields[5] == device:
            return normalize_mac(fields[3])
    return None


def neighbor_mac_bsd(ip, device):
    # "? (10.0.0.2) at 0:11:22:aa:bb:cc on en0 ifscope [ethernet]", with
    # "(incomplete)" in place of the address for a request still out.
    try:
        listing = subprocess.run(
            ["arp", "-n", ip], capture_output=True, text=True
        ).stdout
    except OSError as error:
        fail(f"cannot run arp: {error.strerror}")
    for line in listing.splitlines():
        fields = line.split()
        if "at" not in fields or "on" not in fields:
            continue
        at, on = fields.index("at"), fields.index("on")
        if fields[on + 1:on + 2] == [device]:
            return normalize_mac(fields[at + 1])
    return None


def neighbor_mac_windows(ip, device):
    index = socket.if_nametoindex(device)
    for row in iphlpapi_table("GetIpNetTable", MibIpNetRow):
        if row.index != index or dotted_quad(row.address) != ip:
            continue
        if row.type == IPNET_TYPE_INVALID:
            return None
        octets = bytes(row.physical[:row.physical_length])
        return normalize_mac(":".join(f"{octet:02x}" for octet in octets))
    return None


def neighbor_mac(ip, device):
    if sys.platform == "win32":
        return neighbor_mac_windows(ip, device)
    if sys.platform == "darwin":
        return neighbor_mac_bsd(ip, device)
    return neighbor_mac_linux(ip, device)


def outgoing_address(ip):
    """The local address the kernel would send to an address from.

    Connecting a datagram socket runs the route lookup and puts
    nothing on the wire. The answer names one interface where a subnet
    can name two, and a neighbor entry lives only on the interface
    carrying the traffic.
    """
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        try:
            probe.connect((ip, DISCARD_PORT))
        except OSError as error:
            fail(f"no route to {ip}: {error.strerror}")
        return probe.getsockname()[0]


def resolve_neighbor(ip, device):
    """The MAC for an address, after asking the kernel to go and find it.

    A datagram to a host makes the kernel resolve its address first, so
    one that is up lands in the table; one that is asleep may be there
    already from before it went down.
    """
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        try:
            probe.sendto(b"", (ip, DISCARD_PORT))
        except OSError:
            pass
    deadline = time.monotonic() + RESOLVE_TIMEOUT
    while True:
        mac = neighbor_mac(ip, device)
        if mac or time.monotonic() >= deadline:
            return mac
        time.sleep(0.1)


def send_magic_packet(mac, broadcast, source):
    payload = b"\xff" * 6 + bytes.fromhex(mac.replace(":", "")) * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sender:
        sender.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        try:
            # Binding pins the packet to the interface the address was
            # chosen for, which a limited broadcast would otherwise leave
            # to the routing table.
            sender.bind((source, 0))
            sender.sendto(payload, (broadcast, DISCARD_PORT))
        except OSError as error:
            fail(f"cannot send to {broadcast}: {error.strerror}")


def remember(cache, mac):
    if cache.is_file() and cache.read_text().strip() == mac:
        return
    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(mac + "\n")


def recall(cache):
    try:
        return normalize_mac(cache.read_text().strip())
    except OSError:
        return None


def main(argv):
    if len(argv) != 2:
        print("Usage: wake <hostname|ip>", file=sys.stderr)
        return 2
    target = argv[1]

    try:
        ip = socket.getaddrinfo(
            target, None, socket.AF_INET, socket.SOCK_DGRAM
        )[0][4][0]
    except socket.gaierror:
        fail(f"cannot resolve {target}")

    source = outgoing_address(ip)
    for device, address, network, broadcast in broadcast_interfaces():
        if address == source:
            break
    else:
        fail(f"{ip} is reached from {source}, which is on no interface "
             f"that can broadcast")
    if ipaddress.IPv4Address(ip) not in network:
        fail(f"{ip} is reached through a gateway; a broadcast on {device} "
             f"will not reach it")

    cache = Path(
        os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache"
    ) / "wake" / target

    mac = resolve_neighbor(ip, device)
    if mac:
        remember(cache, mac)
    else:
        mac = recall(cache)
        if not mac:
            fail(f"no MAC known for {target} ({ip}); run wake while it is "
                 f"up once")
        print(f"wake: {ip} is not in the neighbor table; using cached {mac}",
              file=sys.stderr)

    send_magic_packet(mac, broadcast, source)
    print(f"Sent magic packet for {target} ({ip}, {mac}) to {broadcast} "
          f"via {device}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
