#!/usr/bin/env bash

# Symbolically link to all of the dot files in this directory from the home
# directory. Chain in more git configuration layers.

backup() {
    local link=$1
    local bak=$link.bak
    local n=1
    while [ -e "$bak" ]; do
        bak=$link.bak.$n
        n=$((n+1))
    done
    mv -v "$link" "$bak" || exit $?
}

cd $(dirname $0) || exit $?
if [ -d /mnt/c/windows ]; then
  git config --global include.path ~/.dot/etc/wsl.gitconfig
else
  git config --global include.path ~/.dot/etc/unix.gitconfig
fi

for file in .*; do
    case $file in
        .|..|.git*)
            :
            ;;
        *)
            target=$(pwd)/$file
            link=~/$file
            if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
                : # already linked correctly
            elif [ -e "$link" ] || [ -L "$link" ]; then
                backup "$link"
                ln -s -v "$target" "$link" || exit $?
            else
                ln -s -v "$target" "$link" || exit $?
            fi
        ;;
    esac
done