#!/usr/bin/env bash

# Symbolically link to all of the dot files in this directory from the home
# directory. Chain in more git configuration layers.

backup() {
    local link=$1
    local bak=$link.bak
    local n=1
    while [ -e "$bak" ]; do
        bak=$link.bak.$n
        n=$((n+1))
    done
    mv -v "$link" "$bak" || exit $?
}

link_to() {
    local target=$1
    local link=$2
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        : # already linked correctly
    elif [ -e "$link" ] || [ -L "$link" ]; then
        backup "$link"
        ln -s -v "$target" "$link" || exit $?
    else
        ln -s -v "$target" "$link" || exit $?
    fi
}

cd $(dirname $0) || exit $?
if [ -d /mnt/c/windows ]; then
  git config --global include.path ~/.dot/etc/wsl.gitconfig
else
  git config --global include.path ~/.dot/etc/unix.gitconfig
fi

# ~/.bash_profile takes priority over ~/.profile for login shells, so a
# machine-provided skeleton .bash_profile would silently shadow our .profile
# forever. Back it out of the way even though we don't deploy a replacement.
if [ -e ~/.bash_profile ] || [ -L ~/.bash_profile ]; then
    backup ~/.bash_profile
fi

for file in .*; do
    case $file in
        # ~/.claude holds the Claude CLI's credentials, transcripts and
        # caches, and .claude here holds this repository's own skills. Either
        # one linked over the top of the other loses something live, so the
        # directory is skipped and the files under it that are worth
        # versioning are deployed one at a time below.
        .|..|.git*|.claude)
            :
            ;;
        *)
            link_to "$(pwd)/$file" ~/"$file"
        ;;
    esac
done

# etc/claude is what belongs to the home directory rather than to this
# repository. Claude Code rewrites settings.json as settings are changed, the
# way emacs rewrites custom.el, so the link is what keeps those edits versioned
# instead of stranding them in the home directory.
mkdir -p ~/.claude || exit $?
for file in settings.json hooks; do
    link_to "$(pwd)/etc/claude/$file" ~/.claude/"$file"
done