#!/usr/bin/env bash

# Symbolically link to all of the dot files in this directory from the home
# directory. Chain in more git configuration layers.

backup() {
    local link=$1
    local bak=$link.bak
    local n=1
    while [ -e "$bak" ]; do
        bak=$link.bak.$n
        n=$((n+1))
    done
    mv -v "$link" "$bak" || exit $?
}

link_to() {
    local target=$1
    local link=$2
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        : # already linked correctly
    elif [ -e "$link" ] || [ -L "$link" ]; then
        backup "$link"
        ln -s -v "$target" "$link" || exit $?
    else
        ln -s -v "$target" "$link" || exit $?
    fi
}

cd $(dirname $0) || exit $?
if [ -d /mnt/c/windows ]; then
  git config --global include.path ~/.dot/etc/wsl.gitconfig
else
  git config --global include.path ~/.dot/etc/unix.gitconfig
fi

# ~/.bash_profile takes priority over ~/.profile for login shells, so a
# machine-provided skeleton .bash_profile would silently shadow our .profile
# forever. Back it out of the way even though we don't deploy a replacement.
if [ -e ~/.bash_profile ] || [ -L ~/.bash_profile ]; then
    backup ~/.bash_profile
fi

for file in .*; do
    case $file in
        # .claude here is this repository's own, holding the skills a session
        # working on it gets, so the home directory's .claude is deployed from
        # .claude.user instead. The name is the only thing special about it:
        # what is versioned inside is opted into by .gitignore, and the
        # credentials, transcripts and caches the Claude CLI writes are left
        # untracked in place, the way .emacs.d carries its own transient half.
        .claude.user)
            link_to "$(pwd)/$file" ~/.claude
            ;;
        .|..|.git*|.claude)
            :
            ;;
        *)
            link_to "$(pwd)/$file" ~/"$file"
        ;;
    esac
done