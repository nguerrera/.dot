{
  "permissions": {
    "ask": [
      "mcp__claude-in-chrome",
      "mcp__claude-in-chrome__*"
    ]
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "attribution": {
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-identity.sh"
          }
        ]
      }
    ]
  }
}
